      have __do_jp : Array ℕ → M (Array ℕ) := fun lens' =>
        have __do_jp := fun __r => lensLoop CL total fuel lens';
        if lens'.size > total then do
          let __r ← reject "invalid bit length repeat"
          __do_jp __r
        else __do_jp ()
      if s ≤ 15 then do
          let lens' ← pure (lens.push s)
          __do_jp lens'
        else
          if s = 16 then
            have __do_jp := fun __r => do
              let r ← bits 2
              let lens' ← pure (pushN (lens.getD (lens.size - 1) 0) (3 + r) lens)
              __do_jp lens';
            if lens.size = 0 then do
              let __r ← reject "repeat with no first length"
              __do_jp __r
            else __do_jp ()
          else
            if s = 17 then do
              let r ← bits 3
              let lens' ← pure (pushN 0 (3 + r) lens)
              __do_jp lens'
            else do
              let r ← bits 7
              let lens' ← pure (pushN 0 (11 + r) lens)
              __do_jp lens'
    else pure lens) =
