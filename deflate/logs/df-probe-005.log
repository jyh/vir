def VIRDeflate.dynamic : M Unit :=
do
  let __do_lift ← bits 5
  have hlit : ℕ := __do_lift + 257
  let __do_lift ← bits 5
  have hdist : ℕ := __do_lift + 1
  let __do_lift ← bits 4
  have hclen : ℕ := __do_lift + 4
  have __do_jp : Unit → M Unit := fun __r => do
    let cl ← readCL ORDER hclen (Array.replicate 19 0)
    let CL ← code cl Mode.strict
    let __do_lift ← fuelNow
    let lens ← lensLoop CL (hlit + hdist) __do_lift #[]
    have __do_jp : Unit → M Unit := fun __r => do
      let L ← code (lens.extract 0 hlit)
      let D ← code (lens.extract hlit (hlit + hdist)) Mode.dist
      huff L D
    if lens.getD 256 0 = 0 then do
        let __r ← reject "missing end-of-block"
        __do_jp __r
      else __do_jp ()
  if hlit > 286 ∨ hdist > 30 then do
      let __r ← reject "too many length or distance symbols"
      __do_jp __r
    else __do_jp ()
