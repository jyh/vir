theorem VIR.Flat.slice_fuse_flat : ∀ (s : Flat.FSlice) (i j : Nat), (s.adv i).adv j = s.adv (i + j) :=
fun s i j =>
  of_eq_true
    (Eq.trans
      (congrFun'
        (congrArg Eq (congr (congrArg (Flat.FSlice.mk s.buf) (Nat.add_assoc s.off i j)) (Nat.sub_sub s.len i j)))
        { buf := s.buf, off := s.off + (i + j), len := s.len - (i + j) })
      (eq_self { buf := s.buf, off := s.off + (i + j), len := s.len - (i + j) }))
