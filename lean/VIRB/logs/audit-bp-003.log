theorem VIR.BPrime.slice_law : ∀ (b : VSlice) (i : Int), advance b i vlen = vlen b - i :=
fun b i => id (Decidable.byContradiction fun a => slice_law._proof_1_3 b i a)
theorem VIR.BPrime.read_law : ∀ (C : Carrier) (b : VSlice) (i j : Int) (k : Int → Out C),
  (advance b i fun s => read_u32 C s j k) = k (C.wire_u32 b.fst (b.snd + (i + j))) :=
fun C b i j k =>
  of_eq_true
    (Eq.trans
      (congrFun' (congrArg Eq (congrArg k (congrArg (C.wire_u32 b.fst) (Int.add_assoc b.snd i j))))
        (k (C.wire_u32 b.fst (b.snd + (i + j)))))
      (eq_self (k (C.wire_u32 b.fst (b.snd + (i + j))))))
