theorem VIR.BPrime.slice_fuse : ∀ {α : Type} (b : VSlice) (i j : Int) (e : VSlice → α),
  (advance b i fun s1 => advance s1 j e) = advance b (i + j) e :=
fun {α} b i j e =>
  of_eq_true
    (Eq.trans
      (congrFun' (congrArg Eq (congrArg e (congrArg (Prod.mk b.fst) (Int.add_assoc b.snd i j))))
        (e (b.fst, b.snd + (i + j))))
      (eq_self (e (b.fst, b.snd + (i + j)))))
theorem VIR.BPrime.guard_merge : ∀ {α : Type} (c1 c2 : Bool) (eok eerr : α),
  vguard c1 (vguard c2 eok eerr) eerr = vguard (c1 && c2) eok eerr :=
fun {α} c1 c2 eok eerr =>
  Bool.casesOn (motive := fun t => c1 = t → vguard c1 (vguard c2 eok eerr) eerr = vguard (c1 && c2) eok eerr) c1
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t =>
          c2 = t → vguard false (vguard c2 eok eerr) eerr = vguard (false && c2) eok eerr) c2
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard false eok eerr) eerr))
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard true eok eerr) eerr)) (Eq.refl c2))
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t => c2 = t → vguard true (vguard c2 eok eerr) eerr = vguard (true && c2) eok eerr)
          c2 (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard false eok eerr) eerr))
          (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard true eok eerr) eerr)) (Eq.refl c2))
    (Eq.refl c1)
