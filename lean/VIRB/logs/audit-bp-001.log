theorem VIR.BPrime.slice_fuse : ∀ {α : Type} (b : VSlice) (i j : Int) (e : VSlice → α),
  (advance b i fun s1 => advance s1 j e) = advance b (i + j) e :=
fun {α} b i j e =>
  of_eq_true
    (Eq.trans
      (congrFun' (congrArg Eq (congrArg e (congrArg (Prod.mk b.fst) (Int.add_assoc b.snd i j))))
        (e (b.fst, b.snd + (i + j))))
      (eq_self (e (b.fst, b.snd + (i + j)))))
theorem VIR.BPrime.guard_merge : ∀ {α : Type} (c1 c2 : Bool) (eok eerr : α),
  vguard c1 (vguard c2 eok eerr) eerr = vguard (c1 && c2) eok eerr :=
fun {α} c1 c2 eok eerr =>
  Bool.casesOn (motive := fun t => c1 = t → vguard c1 (vguard c2 eok eerr) eerr = vguard (c1 && c2) eok eerr) c1
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t =>
          c2 = t → vguard false (vguard c2 eok eerr) eerr = vguard (false && c2) eok eerr) c2
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard false eok eerr) eerr))
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard true eok eerr) eerr)) (Eq.refl c2))
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t => c2 = t → vguard true (vguard c2 eok eerr) eerr = vguard (true && c2) eok eerr)
          c2 (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard false eok eerr) eerr))
          (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard true eok eerr) eerr)) (Eq.refl c2))
    (Eq.refl c1)
@[defeq] theorem VIR.BPrime.beta_lin : ∀ {α β : Type} (v : α) (e : α → β), let_lin v e = e v :=
fun {α β} v e => rfl
@[defeq] theorem VIR.BPrime.aux_read_past_guard : ∀ (C : Carrier) {α : Type} (c : Bool) (b : VSlice) (j : Int)
  (k : Int → α) (d : α), vguard c (read_u32 C b j k) d = read_u32 C b j fun v => vguard c (k v) d :=
fun C {α} c b j k d => rfl
@[defeq] theorem VIR.BPrime.aux_advance_past_guard : ∀ {α : Type} (b : VSlice) (i : Int) (c : Bool) (k : VSlice → α)
  (d : α), (advance b i fun s => vguard c (k s) d) = vguard c (advance b i k) d :=
fun {α} b i c k d => rfl
theorem VIR.BPrime.aux_guard_swap : ∀ {α : Type} (c1 c2 : Bool) (e d : α),
  vguard c1 (vguard c2 e d) d = vguard c2 (vguard c1 e d) d :=
fun {α} c1 c2 e d =>
  Bool.casesOn (motive := fun t => c1 = t → vguard c1 (vguard c2 e d) d = vguard c2 (vguard c1 e d) d) c1
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t => c2 = t → vguard false (vguard c2 e d) d = vguard c2 (vguard false e d) d) c2
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard false e d) d))
          (fun h => Eq.symm h ▸ Eq.refl (vguard false (vguard true e d) d)) (Eq.refl c2))
    (fun h =>
      Eq.symm h ▸
        Bool.casesOn (motive := fun t => c2 = t → vguard true (vguard c2 e d) d = vguard c2 (vguard true e d) d) c2
          (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard false e d) d))
          (fun h => Eq.symm h ▸ Eq.refl (vguard true (vguard true e d) d)) (Eq.refl c2))
    (Eq.refl c1)
theorem VIR.BPrime.slice_law : ∀ (b : VSlice) (i : Int), advance b i vlen = vlen b - i :=
fun b i => id (Decidable.byContradiction fun a => slice_law._proof_1_3 b i a)
theorem VIR.BPrime.read_law : ∀ (C : Carrier) (b : VSlice) (i j : Int) (k : Int → Out C),
  (advance b i fun s => read_u32 C s j k) = k (C.wire_u32 b.fst (b.snd + (i + j))) :=
fun C b i j k =>
  of_eq_true
    (Eq.trans
      (congrFun' (congrArg Eq (congrArg k (congrArg (C.wire_u32 b.fst) (Int.add_assoc b.snd i j))))
        (k (C.wire_u32 b.fst (b.snd + (i + j)))))
      (eq_self (k (C.wire_u32 b.fst (b.snd + (i + j))))))
